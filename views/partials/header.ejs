<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'הרשמה לאירוע' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/style.css">
  <% if (locals.currentPath && locals.currentPath.startsWith('/admin')) { %><link rel="stylesheet" href="/css/admin.css"><script src="/js/admin.js" defer></script><% } %>
</head>
<body class="d-flex flex-column min-vh-100 <%= locals.currentPath && locals.currentPath.startsWith('/admin') ? 'admin-page' : '' %> <%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
