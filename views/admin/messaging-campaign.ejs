<%- include('../partials/header', { title: title }) %>
<%- include('partials/admin-navbar', { sessionUser: locals.sessionUser || {}, memberships: locals.memberships || [] }) %>
<div class="container-fluid px-3 px-md-4 mb-3">
  <div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-outline-secondary btn-sm" href="/admin/events/<%= event._id %>/messaging">חזרה לשליחת הודעות</a>
    <a class="btn btn-outline-success btn-sm" href="/admin/events/<%= event._id %>/registrations">נרשמים</a>
  </div>
</div>

<main class="container-fluid px-3 px-md-4 pb-5">
  <% var campaign = status.campaign; %>
  <% var counts = status.counts || {}; %>
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
      <h1 class="h4 mb-1">מעקב שליחה: <%= campaign.name || event.name %></h1>
      <div class="text-muted small">אירוע: <%= event.name %></div>
      <div class="text-muted small">
        כרטיס מצורף: <%= campaign.attachTicket ? 'כן' : 'לא' %>
        <% if (campaign.attachTicket) { %>
          | השהייה הודעה→כרטיס: <%= campaign.messageToTicketDelaySeconds || 6 %> שניות
          | השהייה לפני נמען הבא: <%= campaign.recipientDelaySeconds || 6 %> שניות
        <% } else { %>
          | השהייה בין נמענים: <%= campaign.recipientDelaySeconds || 6 %> שניות
        <% } %>
      </div>
      <% if (campaign.scheduledAt) { %>
        <div class="text-muted small">
          תוזמן ל: <%= formatDateTimeIsrael(campaign.scheduledAt) %>
          <% if (campaign.status === 'queued') { %> | השליחה תתחיל אוטומטית במועד זה<% } %>
        </div>
      <% } %>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <% if (campaign.status === 'running') { %>
        <form method="post" action="/admin/events/<%= event._id %>/messaging/campaigns/<%= campaign._id %>/pause">
          <button type="submit" class="btn btn-outline-warning">השהיה</button>
        </form>
      <% } %>
      <% if (campaign.status === 'paused') { %>
        <form method="post" action="/admin/events/<%= event._id %>/messaging/campaigns/<%= campaign._id %>/resume">
          <button type="submit" class="btn btn-outline-success">המשך שליחה</button>
        </form>
      <% } %>
      <% if (['queued', 'running', 'paused'].includes(campaign.status)) { %>
        <form method="post" action="/admin/events/<%= event._id %>/messaging/campaigns/<%= campaign._id %>/cancel"
              onsubmit="return confirm('לבטל את המשך השליחה? הודעות שכבר נשלחו לא יבוטלו.');">
          <button type="submit" class="btn btn-outline-danger">ביטול שליחה</button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
      <div class="card admin-card p-3 h-100">
        <div class="small text-muted">סטטוס</div>
        <div class="fw-bold" id="campaignStatus"><%= campaign.status === 'queued' && campaign.scheduledAt ? 'scheduled' : campaign.status %></div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card admin-card p-3 h-100">
        <div class="small text-muted">סה״כ</div>
        <div class="fw-bold" id="totalRecipients"><%= campaign.totalRecipients || 0 %></div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card admin-card p-3 h-100">
        <div class="small text-muted">נשלחו</div>
        <div class="fw-bold text-success" id="sentCount"><%= counts.sent || campaign.sentCount || 0 %></div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card admin-card p-3 h-100">
        <div class="small text-muted">נכשלים</div>
        <div class="fw-bold text-danger" id="failedCount"><%= counts.failed || campaign.failedCount || 0 %></div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card admin-card p-3 h-100">
        <div class="small text-muted">ממתינים</div>
        <div class="fw-bold" id="pendingCount"><%= (counts.pending || 0) + (counts.sending || 0) %></div>
      </div>
    </div>
    <div class="col-6 col-md-2">
      <div class="card admin-card p-3 h-100">
        <div class="small text-muted">דילוגים</div>
        <div class="fw-bold" id="skippedCount"><%= (campaign.duplicatesSkipped || 0) + (campaign.invalidPhoneCount || 0) %></div>
      </div>
    </div>
  </div>

  <% if (campaign.lastError) { %>
    <div class="alert alert-warning" id="lastError"><%= campaign.lastError %></div>
  <% } else { %>
    <div class="alert alert-warning d-none" id="lastError"></div>
  <% } %>

  <div class="card admin-card p-4">
    <h2 class="h5 mb-3">לוג שליחה</h2>
    <div class="table-responsive">
      <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
          <tr>
            <th>שם</th>
            <th>טלפון</th>
            <th>שלב</th>
            <th>סטטוס</th>
            <th>הודעה נשלחה</th>
            <th>כרטיס נשלח</th>
            <th>הושלם</th>
            <th>שגיאה</th>
          </tr>
        </thead>
        <tbody id="recipientLog">
          <% status.recipients.forEach(function(recipient) { %>
            <tr>
              <td><%= recipient.parentFirstName %> <%= recipient.parentLastName %></td>
              <td dir="ltr"><%= recipient.phoneNormalized %></td>
              <td><%= recipient.deliveryStep || 'message' %></td>
              <td><%= recipient.status %></td>
              <td class="text-nowrap"><%= recipient.messageSentAt ? formatDateTimeIsrael(recipient.messageSentAt) : '' %></td>
              <td class="text-nowrap"><%= recipient.ticketSentAt ? formatDateTimeIsrael(recipient.ticketSentAt) : '' %></td>
              <td class="text-nowrap"><%= recipient.sentAt ? formatDateTimeIsrael(recipient.sentAt) : '' %></td>
              <td><%= recipient.error || '' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<script>
  (function () {
    const statusUrl = '<%= `/admin/events/${event._id}/messaging/campaigns/${campaign._id}/status.json` %>';
    const attachTicket = <%= campaign.attachTicket ? 'true' : 'false' %>;
    const formatter = new Intl.DateTimeFormat('he-IL', {
      timeZone: 'Asia/Jerusalem',
      dateStyle: 'short',
      timeStyle: 'short'
    });

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatDate(value) {
      if (!value) return '';
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? '' : formatter.format(date);
    }

    function renderStep(recipient) {
      if (recipient.status === 'sent') {
        return attachTicket ? 'message + ticket' : 'message';
      }
      if (recipient.status === 'failed') {
        return recipient.deliveryStep || 'message';
      }
      if (recipient.deliveryStep === 'ticket') {
        return recipient.messageSentAt ? 'ticket (waiting)' : 'ticket';
      }
      return 'message';
    }

    function renderRows(recipients) {
      return recipients.map(function (recipient) {
        const name = `${recipient.parentFirstName || ''} ${recipient.parentLastName || ''}`.trim();
        return `
          <tr>
            <td>${escapeHtml(name)}</td>
            <td dir="ltr">${escapeHtml(recipient.phoneNormalized)}</td>
            <td>${escapeHtml(renderStep(recipient))}</td>
            <td>${escapeHtml(recipient.status)}</td>
            <td class="text-nowrap">${escapeHtml(formatDate(recipient.messageSentAt))}</td>
            <td class="text-nowrap">${escapeHtml(formatDate(recipient.ticketSentAt))}</td>
            <td class="text-nowrap">${escapeHtml(formatDate(recipient.sentAt))}</td>
            <td>${escapeHtml(recipient.error || '')}</td>
          </tr>
        `;
      }).join('');
    }

    async function refreshStatus() {
      try {
        const response = await fetch(statusUrl, { headers: { Accept: 'application/json' } });
        if (!response.ok) return;
        const data = await response.json();
        const campaign = data.campaign || {};
        const counts = data.counts || {};
        document.getElementById('campaignStatus').textContent =
          campaign.status === 'queued' && campaign.scheduledAt ? 'scheduled' : (campaign.status || '');
        document.getElementById('totalRecipients').textContent = campaign.totalRecipients || 0;
        document.getElementById('sentCount').textContent = counts.sent || campaign.sentCount || 0;
        document.getElementById('failedCount').textContent = counts.failed || campaign.failedCount || 0;
        document.getElementById('pendingCount').textContent = (counts.pending || 0) + (counts.sending || 0);
        document.getElementById('skippedCount').textContent = (campaign.duplicatesSkipped || 0) + (campaign.invalidPhoneCount || 0);
        document.getElementById('recipientLog').innerHTML = renderRows(data.recipients || []);

        const lastError = document.getElementById('lastError');
        if (campaign.lastError) {
          lastError.textContent = campaign.lastError;
          lastError.classList.remove('d-none');
        } else {
          lastError.textContent = '';
          lastError.classList.add('d-none');
        }
      } catch (err) {
        // Keep the current snapshot visible if polling temporarily fails.
      }
    }

    setInterval(refreshStatus, 3000);
  })();
</script>
<%- include('../partials/footer') %>
