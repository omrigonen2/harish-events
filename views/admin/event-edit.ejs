<%- include('../partials/header', { title: title }) %>
<%- include('partials/admin-navbar', { sessionUser: locals.sessionUser || {}, memberships: locals.memberships || [] }) %>
<div class="container-fluid px-3 px-md-4 mb-3">
  <div class="d-flex gap-2 flex-wrap">
    <% var previewReg = '/register/' + encodeURIComponent(editEvent.slug || ''); %>
    <a class="btn btn-outline-primary btn-sm" href="<%= previewReg %>" target="_blank" rel="noopener">תצוגה מקדימה</a>
    <a class="btn btn-outline-success btn-sm" href="/admin/events/<%= editEvent._id %>/registrations">נרשמים</a>
    <a class="btn btn-outline-info btn-sm" href="/admin/events/<%= editEvent._id %>/messaging">שליחת הודעות</a>
  </div>
</div>
<main class="container pb-5">
  <% if (formError) { %>
    <div class="alert alert-danger"><%= formError %></div>
  <% } %>

  <div class="row justify-content-center">
    <div class="col-xl-10">
      <h1 class="h4 mb-4">עריכת אירוע: <%= editEvent.name %></h1>

      <div class="card admin-card p-4 mb-4">
        <h2 class="h5 mb-3">פרטי האירוע</h2>
        <form method="post" action="/admin/events/<%= editEvent._id %>/update">
          <div class="mb-3">
            <label class="form-label">שם האירוע *</label>
            <input class="form-control" name="name" required value="<%= editEvent.name %>">
          </div>
          <div class="mb-3">
            <label class="form-label" for="eventDescription">תיאור האירוע</label>
            <p class="small text-muted mb-2">עורך טקסט עשיר (TinyMCE) — עיצוב, קישורים וטבלאות.</p>
            <textarea id="eventDescription" name="description" class="form-control" rows="10"><%- (locals.editDescriptionHtml != null ? locals.editDescriptionHtml : '') %></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">מועד</label>
            <input class="form-control" type="datetime-local" name="date"
              value="<%= typeof eventDateInput !== 'undefined' ? eventDateInput : '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">כתובת קבועה (slug)</label>
            <input class="form-control" name="slug" value="<%= editEvent.slug %>">
            <p class="small text-muted mb-0">כתובת הציבור לטופס: <code class="user-select-all"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/register/<%= encodeURIComponent(editEvent.slug || '') %></code></p>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="isActive" id="isActive" <%= editEvent.isActive ? 'checked' : '' %>>
            <label class="form-check-label" for="isActive">אירוע פעיל (מוצג לציבור)</label>
          </div>

          <hr class="my-4">
          <h3 class="h6">הרשמה</h3>
          <div class="form-check mb-3">
            <input type="hidden" name="hasChildrenPresent" value="1">
            <input class="form-check-input" type="checkbox" name="hasChildren" id="hasChildrenEdit"
              <%= editEvent.hasChildren !== false ? 'checked' : '' %>>
            <label class="form-check-label" for="hasChildrenEdit">באירוע משתתפים ילדים</label>
            <p class="small text-muted mb-0">בטל אם זה אירוע למבוגרים בלבד. שדה ה&quot;ילדים&quot; ועמודות הילדים יוסתרו אוטומטית.</p>
          </div>
          <div class="mb-3">
            <label class="form-label">מגבלת הרשמות</label>
            <input class="form-control" type="number" name="signupLimit" min="0" step="1" placeholder="ריק = ללא הגבלה"
              value="<%= editEvent.signupLimit != null && editEvent.signupLimit !== '' ? editEvent.signupLimit : '' %>">
            <p class="small text-muted mb-0">השאירו ריק כדי לאפשר הרשמות בלי מכסה.</p>
          </div>
          <div class="mb-3">
            <label class="form-label">ספירה למכסה</label>
            <select class="form-select" name="signupLimitCountMode" id="signupLimitCountModeEdit">
              <option value="families" <%= (editEvent.signupLimitCountMode || 'families') === 'families' ? 'selected' : '' %>>משפחות (הרשמה אחת לכל טופס)</option>
              <option value="participants" data-needs-children="true" <%= editEvent.signupLimitCountMode === 'participants' ? 'selected' : '' %>>משתתפים (מבוגר אחד + כל ילד נספר)</option>
              <option value="children" data-needs-children="true" <%= editEvent.signupLimitCountMode === 'children' ? 'selected' : '' %>>ילדים בלבד (ספירת כל ילד בטפסים)</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">סגירת הרשמות</label>
            <input class="form-control" type="datetime-local" name="signupCloseAt"
              value="<%= typeof signupCloseAtInput !== 'undefined' ? signupCloseAtInput : '' %>">
            <p class="small text-muted mb-0">ריק = ההרשמה לא נסגרת לפי זמן (רק לפי מכסה / כיבוי אירוע).</p>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="signupPhoneUnique" id="signupPhoneUnique"
              <%= editEvent.signupPhoneUnique ? 'checked' : '' %>>
            <label class="form-check-label" for="signupPhoneUnique">לאפשר הרשמה אחת בלבד לכל מספר טלפון</label>
            <p class="small text-muted mb-0">כאשר האפשרות פעילה, ניסיון הרשמה נוסף עם אותו מספר יקבל הודעת שגיאה.</p>
          </div>
          <div class="form-check mb-3">
            <input type="hidden" name="ticketCapIncludesRegistrantPresent" value="1">
            <input class="form-check-input" type="checkbox" name="ticketCapIncludesRegistrant" id="ticketCapIncludesRegistrant"
              <%= editEvent.ticketCapIncludesRegistrant ? 'checked' : '' %>>
            <label class="form-check-label" for="ticketCapIncludesRegistrant">מגבלת אנשים בכרטיס כוללת את הנרשם הראשי</label>
            <p class="small text-muted mb-0">רלוונטי רק כאשר נקבעה מגבלה ברשימת האנשים בטופס. לדוגמה, &quot;5&quot; ייצור כרטיס שמכיל הורה + 4 נוספים.</p>
          </div>

          <hr class="my-4">
          <h3 class="h6">כרטיסים וכניסה</h3>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="ticketsEnabled" id="ticketsEnabled"
              <%= editEvent.ticketsEnabled ? 'checked' : '' %>>
            <label class="form-check-label" for="ticketsEnabled">שליחת כרטיס בוואטסאפ עם QR</label>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="ticketsGateAllowCountEdit" id="ticketsGateAllowCountEdit"
              <%= editEvent.ticketsGateAllowCountEdit ? 'checked' : '' %>>
            <label class="form-check-label" for="ticketsGateAllowCountEdit">לאפשר לצוות הסריקה לשנות כמות מבוגרים וילדים לפני צריבת הכרטיס</label>
            <p class="small text-muted mb-0">כאשר האפשרות כבויה, הסריקה מציגה את הכמות המקורית והאישור צורב אותה ללא שינוי.</p>
          </div>
          <% if (editEvent.ticketsEnabled && typeof gateUrl !== 'undefined' && gateUrl) { %>
            <div class="mb-3">
              <label class="form-label">קישור סריקה לצוות האירוע</label>
              <div class="input-group">
                <input class="form-control" id="gateUrl" value="<%= gateUrl %>" readonly dir="ltr">
                <button class="btn btn-outline-secondary" type="button"
                  onclick="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('gateUrl').value)">העתקה</button>
              </div>
              <p class="small text-muted mb-2">זהו קישור ללא התחברות. שתפו רק עם מי שמנהל כניסה לאירוע.</p>
              <button type="submit" form="rotateTicketLinkForm" class="btn btn-outline-danger btn-sm">יצירת קישור חדש</button>
            </div>
          <% } %>

          <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">שמירה</button>
            <a href="/admin/events" class="btn btn-outline-secondary">חזרה לרשימת האירועים</a>
          </div>
        </form>
        <% if (editEvent.ticketsEnabled && typeof gateUrl !== 'undefined' && gateUrl) { %>
          <form id="rotateTicketLinkForm" method="post" action="/admin/events/<%= editEvent._id %>/tickets/rotate"
                onsubmit="return confirm('ליצור קישור סריקה חדש? הקישור הישן יפסיק לעבוד.');"></form>
        <% } %>
      </div>

      <% if (builderConfig) { %>
        <%- include('partials/form-builder-section', {
          event: editEvent,
          config: builderConfig,
          configRaw: builderConfigRaw,
          formBuilderError: typeof formBuilderError !== 'undefined' ? formBuilderError : null
        }) %>
        <p class="mb-4">
          <a href="/admin/events" class="btn btn-outline-secondary">חזרה לרשימת האירועים</a>
        </p>
      <% } %>
    </div>
  </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js" crossorigin="anonymous"></script>
<script src="/js/tinymce-event.js"></script>
<script>
(function () {
  var hc = document.getElementById('hasChildrenEdit');
  var mode = document.getElementById('signupLimitCountModeEdit');
  if (!hc || !mode) return;
  function sync() {
    var enabled = hc.checked;
    Array.from(mode.options).forEach(function (opt) {
      if (opt.dataset.needsChildren === 'true') {
        opt.hidden = !enabled;
        opt.disabled = !enabled;
      }
    });
    if (!enabled && mode.selectedOptions[0] && mode.selectedOptions[0].dataset.needsChildren === 'true') {
      mode.value = 'families';
    }
  }
  hc.addEventListener('change', sync);
  sync();
})();
</script>
<%- include('../partials/footer') %>
