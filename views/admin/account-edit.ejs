<%- include('../partials/header', { title: title }) %>
<%- include('partials/admin-navbar', { sessionUser: locals.sessionUser || {}, memberships: locals.memberships || [] }) %>
<main class="container pb-5" style="max-width: 36rem;">
  <h1 class="h4 mb-4">עריכת ארגון</h1>

  <% if (formError) { %>
    <div class="alert alert-danger"><%= formError %></div>
  <% } %>

  <div class="card admin-card p-4">
    <form method="post" action="/admin/accounts/<%= account._id %>/update" data-dirty-track>
      <div class="mb-3">
        <label class="form-label">שם הארגון *</label>
        <input class="form-control" name="name" required value="<%= account.name %>">
      </div>
      <div class="mb-3">
        <label class="form-label">מזהה (slug)</label>
        <input class="form-control" name="slug" value="<%= account.slug %>" dir="ltr">
        <p class="small text-muted mb-0">מזהה ייחודי לניהול פנימי; אם השם תפוס יתווסף מספר אוטומטית.</p>
      </div>
      <div class="mb-4"><label class="form-label" for="brandColor">צבע המותג לטפסים חדשים</label><input type="color" class="form-control form-control-color" id="brandColor" name="brandColor" value="<%= account.brandColor || '#126c59' %>"></div>
      <div class="mb-4"><label class="form-label" for="accountLogo">לוגו הארגון לטפסים חדשים</label><div class="image-upload" data-image-upload><input type="hidden" name="logoKey" value="<%= account.logoUrl || '' %>"><img src="<%= locals.accountLogoUrl || '' %>" alt="לוגו הארגון" <%- !locals.accountLogoUrl ? 'hidden' : '' %>><input class="form-control" id="accountLogo" type="file" accept="image/*"><small class="text-muted" data-upload-status>הלוגו ישמש כברירת מחדל באירועים חדשים.</small><button type="button" class="btn btn-sm btn-light mt-2" data-clear-image>הסרה</button></div></div>
      <div class="d-flex gap-2 flex-wrap">
        <button type="submit" class="btn btn-primary">שמירה</button>
        <a href="/admin/accounts/<%= account._id %>/users" class="btn btn-outline-secondary">משתמשים</a>
        <a href="/admin/accounts" class="btn btn-outline-secondary">כל הארגונים</a>
      </div>
    </form>
  </div>
</main>
<script src="/js/event-builder.js" defer></script><%- include('../partials/footer') %>
