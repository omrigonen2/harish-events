<%- include('../partials/header', { title }) %>
<%- include('partials/admin-navbar', { sessionUser: locals.sessionUser || {}, memberships: locals.memberships || [] }) %>
<main class="container pb-5"><%- include('partials/event-header', { event, activeTab: 'registrations' }) %>
<div class="stat-grid"><div class="stat-card"><small>הרשמות פעילות</small><strong><%= stats.registrations %></strong></div><div class="stat-card"><small>משתתפים צפויים</small><strong><%= stats.participants %></strong></div><div class="stat-card"><small>משתתפים שנכנסו</small><strong><%= stats.checkedInPeople %></strong></div><div class="stat-card"><small>הרשמות מבוטלות</small><strong><%= stats.cancelled %></strong></div></div>
<section data-filter-table><div class="toolbar"><input class="form-control" type="search" data-search placeholder="חיפוש לפי שם או טלפון" aria-label="חיפוש הרשמה"><select class="form-select" data-filter aria-label="סינון הרשמות"><option value="confirmed">הרשמות פעילות</option><option value="">כל ההרשמות</option><option value="arrived">נכנסו לאירוע</option><option value="waiting">טרם נכנסו</option><option value="failed">שליחת כרטיס נכשלה</option><option value="cancelled">מבוטלות</option></select><span class="list-count" data-count></span><a class="btn btn-light" href="/admin/events/<%= event._id %>/registrations/export.csv">ייצוא הרשמות פעילות</a></div><div class="admin-table-wrap table-responsive"><table class="table"><thead><tr><th>איש קשר ראשי</th><th>טלפון</th><th>משתתפים</th><th>הרשמה</th><th>שליחת כרטיס</th><th>כניסה</th><th></th></tr></thead><tbody>
<% registrations.forEach(r=>{const counts=participantCounts(r,event);const delivery=deliveryState(r);const cancelled=r.status==='cancelled'; const tokens=[cancelled?'cancelled':'confirmed',!cancelled&&r.ticketCheckedInAt?'arrived':'',!cancelled&&!r.ticketCheckedInAt?'waiting':'',!cancelled&&delivery.key==='failed'?'failed':''].join(' ');%>
<tr data-search-text="<%= [r.parentFirstName,r.parentLastName,r.phone,r.phoneNormalized,...additionalParticipants(r,event).map(p=>p.name)].join(' ') %>" data-status="<%= tokens %>"><td><a class="event-name" href="/admin/events/<%= event._id %>/registrations/<%= r._id %>"><%= [r.parentFirstName,r.parentLastName].filter(Boolean).join(' ') || 'ללא שם' %></a><span class="table-subtext"><%= r.createdAt?formatDateTimeIsrael(r.createdAt):'' %></span></td><td dir="ltr" class="text-end"><%= r.phone %></td><td><strong><%= counts.total %></strong><div class="table-subtext"><%= additionalParticipants(r,event).map(p=>p.name).join(', ') %></div></td><td><span class="status-pill <%= cancelled?'secondary':'success' %>"><%= cancelled?'מבוטלת':'פעילה' %></span></td><td><% if(event.ticketsEnabled){%><span class="status-pill <%= delivery.tone %>"><%= delivery.label %></span><% } else { %><span class="table-subtext">ללא כרטיסים</span><% } %></td><td><span class="status-pill <%= cancelled?'secondary':r.ticketCheckedInAt?'success':'secondary' %>"><%= cancelled?'הכרטיס מבוטל':r.ticketCheckedInAt?'הכרטיס מומש':'טרם נכנסו' %></span></td><td><a class="btn btn-sm btn-light" href="/admin/events/<%= event._id %>/registrations/<%= r._id %>">פרטים ועריכה</a></td></tr>
<% }); %><% if(!registrations.length){ %><tr><td colspan="7"><div class="empty-state"><h2>עדיין אין הרשמות לאירוע</h2><p>שתפו את קישור ההרשמה כדי להתחיל.</p></div></td></tr><% } %>
</tbody></table></div></section></main><%- include('../partials/footer') %>
