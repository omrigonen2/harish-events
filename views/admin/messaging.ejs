<%- include('../partials/header', { title }) %><%- include('partials/admin-navbar', { sessionUser: locals.sessionUser || {}, memberships: locals.memberships || [] }) %>
<main class="container pb-5"><%- include('partials/event-header', { event, activeTab:'messaging' }) %>
<% if(formError||testError){%><div class="alert alert-danger"><%= formError||testError %></div><% } %><% if(formMessage||testMessage){%><div class="alert alert-success"><%= formMessage||testMessage %></div><% } %>
<form id="campaignForm" method="post" action="/admin/events/<%= event._id %>/messaging/start" enctype="multipart/form-data" data-dirty-track>
<div class="form-layout"><div><section class="admin-panel"><h2>הודעה חדשה לנרשמים</h2><p class="section-help">הכינו הודעה, בדקו אותה עם נרשם לדוגמה ובחרו מתי לשלוח.</p><label class="form-label" for="campaignName">שם פנימי</label><input class="form-control mb-3" id="campaignName" name="name" placeholder="לדוגמה: תזכורת יום לפני האירוע"><label class="form-label" for="messageText">תוכן ההודעה</label><textarea class="form-control" name="messageText" id="messageText" rows="8" required></textarea><div class="d-flex flex-wrap gap-2 my-3"><% [['parentFirstName','שם פרטי'],['parentLastName','שם משפחה'],['eventName','שם האירוע'],['eventDate','מועד האירוע'],['ticketUrl','קישור לכרטיס']].forEach(([key,label])=>{%><button class="btn btn-sm btn-light" type="button" data-insert-variable="<%= key %>">+ <%= label %></button><% }); %></div><label class="form-label" for="messageImage">תמונה מצורפת</label><input type="file" class="form-control" name="image" id="messageImage" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml"><input type="hidden" name="imageKey" value=""></section>
<section class="admin-panel"><h2>נמענים ותזמון</h2><div class="d-flex gap-4 my-3"><label><input class="form-check-input" type="radio" name="audienceMode" value="all" checked> כל הנרשמים הפעילים</label><label><input class="form-check-input" type="radio" name="audienceMode" value="selected"> בחירה ידנית</label></div><div id="recipientPicker" hidden><div class="toolbar"><input type="search" class="form-control" id="recipientSearch" aria-label="חיפוש נמען" placeholder="שם או טלפון"><button class="btn btn-sm btn-light" type="button" id="selectVisibleBtn">בחירת המוצגים</button><button class="btn btn-sm btn-light" type="button" id="clearSelectionBtn">ניקוי בחירה</button></div><div class="table-responsive mb-4" style="max-height:300px"><table class="table table-sm"><thead><tr><th></th><th>שם</th><th>טלפון</th></tr></thead><tbody id="recipientRows"><% registrations.forEach(r=>{%><tr data-name="<%= [r.parentFirstName,r.parentLastName,r.phone].join(' ').toLowerCase() %>"><td><input type="checkbox" class="form-check-input recipient-checkbox" name="registrationIds" value="<%= r._id %>" aria-label="בחירת <%= r.parentFirstName %> <%= r.parentLastName %>"></td><td><%= r.parentFirstName %> <%= r.parentLastName %></td><td dir="ltr"><%= r.phone %></td></tr><% });%></tbody></table></div></div>
<% if(event.ticketsEnabled){%><div class="form-check mb-4"><input class="form-check-input" type="checkbox" id="attachTicket" name="attachTicket" value="1"><label class="form-check-label" for="attachTicket">שליחת הכרטיס האישי אחרי ההודעה</label></div><% } %>
<div class="row g-3"><div class="col-md-6"><label class="form-label" for="scheduledAt">מועד שליחה</label><input class="form-control" type="datetime-local" name="scheduledAt" id="scheduledAt"><p class="form-text">ריק: שליחה מיידית.</p></div><div class="col-md-3"><label class="form-label" for="recipientDelay">השהייה בין נמענים</label><div class="input-group"><input class="form-control" type="number" name="recipientDelaySeconds" id="recipientDelay" min="1" max="3600" value="6"><span class="input-group-text">ש׳</span></div></div><div class="col-md-3" id="ticketDelayFields" hidden><label class="form-label" for="ticketDelay">השהייה לפני כרטיס</label><div class="input-group"><input class="form-control" type="number" name="messageToTicketDelaySeconds" id="ticketDelay" min="1" max="3600" value="6"><span class="input-group-text">ש׳</span></div></div></div></section>
</div><aside class="side-note"><section class="admin-panel"><h2>תצוגה מקדימה</h2><p class="section-help">בחרו נרשם לדוגמה כדי לבדוק את השמות בהודעה.</p><select class="form-select mb-3" name="testRegistrationId" id="testRegistrationId" aria-label="נרשם לדוגמה"><option value="">ערכי דוגמה</option><% registrations.forEach(r=>{%><option value="<%= r._id %>" data-first="<%= r.parentFirstName %>" data-last="<%= r.parentLastName %>"><%= r.parentFirstName %> <%= r.parentLastName %></option><% }); %></select><div class="event-preview-card text-end" id="messagePreview" data-event="<%= event.name %>" data-date="<%= event.date?formatDateTimeIsrael(event.date):'' %>" style="white-space:pre-wrap;overflow-wrap:anywhere">ההודעה תופיע כאן בזמן הכתיבה.</div><button class="btn btn-light w-100 mt-3" type="button" data-bs-toggle="modal" data-bs-target="#messageTestModal">שליחת בדיקה</button><p class="form-text mb-0 mt-2">הבדיקה תשתמש בתוכן ובתמונה שהגדרתם כאן.</p></section><section class="admin-panel"><h2>סיכום השליחה</h2><p class="section-help mb-0" id="campaignSummary" data-total="<%= registrations.length %>"></p></section></aside></div>
<div class="form-savebar"><span class="dirty-indicator" data-save-state>טיוטת הודעה חדשה</span><div class="d-flex gap-2"><button class="btn btn-light" type="button" data-bs-toggle="modal" data-bs-target="#messageTestModal">בדיקה</button><button class="btn btn-primary" type="submit">שליחה או תזמון</button></div></div>
<div class="modal fade" id="messageTestModal" tabindex="-1" aria-labelledby="testTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="h5 modal-title" id="testTitle">שליחת הודעת בדיקה</h2><button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="סגירה"></button></div><div class="modal-body"><p class="section-help">התוכן והתמונה יישלחו למספר הבדיקה בלבד. אם מצרפים כרטיס, בחרו נרשם לדוגמה לפני פתיחת החלון.</p><label class="form-label" for="testPhone">מספר הטלפון לבדיקה</label><input class="form-control" name="testPhone" id="testPhone" type="tel" dir="ltr" placeholder="0501234567"><div id="testFeedback" role="status" class="small mt-3"></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">סגירה</button><button type="button" class="btn btn-primary" id="sendTestButton" data-url="/admin/events/<%= event._id %>/messaging/test">שליחת בדיקה למספר זה</button></div></div></div></div>
</form>
<section class="admin-panel mt-4"><h2>היסטוריית הודעות</h2><p class="section-help">מעקב אחרי התזמון ותוצאות השליחה.</p><% if(!campaigns.length){%><p class="text-muted">טרם נשלחו הודעות לאירוע.</p><% }else{ %><div class="table-responsive"><table class="table"><thead><tr><th>הודעה</th><th>מצב</th><th>מועד</th><th>נמענים</th><th>נשלחו</th><th>נכשלו</th><th></th></tr></thead><tbody><%const labels={queued:'מתוזמנת',running:'בשליחה',paused:'מושהית',completed:'הסתיימה',cancelled:'בוטלה'}; campaigns.forEach(c=>{%><tr><td><%= c.name||'הודעה לנרשמים' %></td><td><span class="status-pill <%= c.status==='completed'?'success':'secondary' %>"><%= labels[c.status]||c.status %></span></td><td><%= c.scheduledAt?formatDateTimeIsrael(c.scheduledAt):'מיידי' %></td><td><%= c.totalRecipients %></td><td><%= c.sentCount %></td><td><%= c.failedCount %></td><td><a class="btn btn-sm btn-light" href="/admin/events/<%= event._id %>/messaging/campaigns/<%= c._id %>">פרטי שליחה</a></td></tr><% });%></tbody></table></div><% } %></section></main>
<script src="/js/messaging.js" defer></script><%- include('../partials/footer') %>
