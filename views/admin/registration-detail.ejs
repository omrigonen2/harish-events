<%- include('../partials/header', { title }) %>
<%- include('partials/admin-navbar', { sessionUser: locals.sessionUser || {}, memberships: locals.memberships || [] }) %>
<% const base='/admin/events/'+event._id+'/registrations/'+registration._id; const people=additionalParticipants(registration,event); const counts=participantCounts(registration,event); const delivery=deliveryState(registration); %>
<main class="container pb-5"><%- include('partials/event-header', { event, activeTab: 'registrations' }) %><a class="breadcrumb-link" href="/admin/events/<%= event._id %>/registrations">← חזרה לרשימת ההרשמות</a><div class="page-heading"><div><h2 class="h4 mb-1">פרטי הרשמה</h2><p class="text-muted mb-0"><%= [registration.parentFirstName,registration.parentLastName].join(' ') %></p></div><span class="status-pill <%= registration.status==='cancelled'?'secondary':'success' %>"><%= registration.status==='cancelled'?'הרשמה מבוטלת':'הרשמה פעילה' %></span></div>
<% if(saved){%><div class="alert alert-success">פרטי ההרשמה נשמרו.</div><% } %><% if(ticketSent){%><div class="alert alert-success">הכרטיס נשלח בוואטסאפ.</div><% } %>
<div class="form-layout"><div><form method="post" action="<%= base %>/update" data-dirty-track><section class="admin-panel"><h2>איש הקשר הראשי</h2><p class="section-help">איש הקשר נכלל במספר המשתתפים בהרשמה.</p><div class="row g-3"><div class="col-md-6"><label class="form-label" for="firstName">שם פרטי</label><input class="form-control" id="firstName" name="parentFirstName" value="<%= registration.parentFirstName %>" maxlength="120"></div><div class="col-md-6"><label class="form-label" for="lastName">שם משפחה</label><input class="form-control" id="lastName" name="parentLastName" value="<%= registration.parentLastName %>" maxlength="120"></div><div class="col-12"><label class="form-label" for="phone">טלפון</label><input class="form-control" id="phone" name="phone" value="<%= registration.phone %>" dir="ltr" maxlength="30"></div></div></section><section class="admin-panel"><div class="d-flex align-items-center justify-content-between mb-3"><h2 class="mb-0">משתתפים נוספים</h2><button type="button" class="btn btn-sm btn-light" id="addParticipant">+ משתתף</button></div><p class="section-help">רשימה זו אינה כוללת את איש הקשר הראשי.</p><div id="participantRows"><% people.forEach((p,i)=>{%><div class="participant-row row g-2 mb-3"><div class="col-md-5"><label class="form-label w-100">שם<input class="form-control" data-person="name" name="participants[<%= i %>][name]" value="<%= p.name %>" maxlength="120"></label></div><div class="col-5 col-md-3"><label class="form-label w-100">סוג<select class="form-select" data-person="category" name="participants[<%= i %>][category]"><% [['general','משתתף'],['adult','מבוגר'],['child','ילד']].forEach(([v,l])=>{%><option value="<%= v %>" <%= p.category===v?'selected':'' %>><%= l %></option><% });%></select></label></div><div class="col-5 col-md-3"><label class="form-label w-100">גיל<input class="form-control" type="number" min="0" max="120" data-person="age" name="participants[<%= i %>][age]" value="<%= p.age ?? '' %>"></label></div><div class="col-2 col-md-1 d-flex align-items-end pb-2"><button type="button" class="btn btn-sm btn-light" data-remove-person aria-label="הסרת משתתף">×</button></div></div><% }); %></div><template id="participantRowTemplate"><div class="participant-row row g-2 mb-3"><div class="col-md-5"><label class="form-label w-100">שם<input class="form-control" data-person="name" maxlength="120"></label></div><div class="col-5 col-md-3"><label class="form-label w-100">סוג<select class="form-select" data-person="category"><option value="general">משתתף</option><option value="adult">מבוגר</option><option value="child">ילד</option></select></label></div><div class="col-5 col-md-3"><label class="form-label w-100">גיל<input class="form-control" type="number" min="0" max="120" data-person="age"></label></div><div class="col-2 col-md-1 d-flex align-items-end pb-2"><button type="button" class="btn btn-sm btn-light" data-remove-person aria-label="הסרת משתתף">×</button></div></div></template></section><div class="form-savebar"><span class="dirty-indicator" data-save-state>כל השינויים נשמרו</span><button class="btn btn-primary">שמירת פרטי ההרשמה</button></div></form>
<% if(customFieldDefs.length){%><section class="admin-panel mt-4"><h2>תשובות שנמסרו בהרשמה</h2><p class="section-help">האישורים המקוריים נשמרים כפי שנמסרו על ידי הנרשם.</p><dl><% customFieldDefs.forEach(f=>{%><dt class="small mb-1"><%= f.label %></dt><dd class="mb-3"><%const value=registration.customFields?.[f.id];%><%= value === true?'כן':value === false?'לא':value ?? 'לא נמסרה תשובה' %></dd><% });%></dl></section><% } %></div>
<aside><section class="admin-panel"><h2>כרטיס וכניסה</h2><p class="section-help"><%= counts.total %> משתתפים בהרשמה</p><span class="status-pill <%= delivery.tone %>"><%= delivery.label %></span><p class="small mt-3"><%= registration.ticketCheckedInAt?'הכרטיס מומש: '+formatDateTimeIsrael(registration.ticketCheckedInAt):'הכרטיס טרם מומש בכניסה' %></p><% if(registration.ticketWhatsAppError){%><p class="small text-danger"><%= registration.ticketWhatsAppError %></p><% } %><% if(registration.status!=='cancelled'&&event.ticketsEnabled&&!event.archivedAt){%><form method="post" action="<%= base %>/send-ticket"><button class="btn btn-outline-primary w-100">שליחת כרטיס בוואטסאפ</button></form><% if(registration.ticketToken){%><a class="btn btn-light w-100 mt-2" href="/ticket/<%= registration.ticketToken %>" target="_blank" rel="noopener">פתיחת הכרטיס ↗</a><% } %><% } %></section><section class="admin-panel"><h2><%= registration.status==='cancelled'?'שחזור הרשמה':'ביטול הרשמה' %></h2><p class="section-help">הפרטים והיסטוריית הכניסה נשמרים. הרשמה מבוטלת אינה תופסת מקום במכסה וכרטיסה אינו מאפשר כניסה.</p><form method="post" action="<%= base %>/<%= registration.status==='cancelled'?'restore':'delete' %>"><button class="btn <%= registration.status==='cancelled'?'btn-light':'btn-outline-danger' %>"><%= registration.status==='cancelled'?'שחזור הרשמה':'ביטול הרשמה' %></button></form></section></aside></div></main>
<script src="/js/registration-detail.js" defer></script><%- include('../partials/footer') %>
