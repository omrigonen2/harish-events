<input type="hidden" name="fieldsJson" id="fieldsJson" value="<%= JSON.stringify(fields || []) %>">
<script type="application/json" id="fields-config"><%- JSON.stringify(fields || []).replace(/</g, '\\u003c') %></script>
<div id="fieldList"></div>
<template id="field-editor-template"><details class="field-editor" draggable="true"><summary><span class="field-title flex-grow-1"></span><span class="field-type text-muted small"></span></summary><div class="field-controls"><div><label class="form-label">כותרת השדה<input class="form-control" data-prop="label" maxlength="500"></label></div><div><label class="form-label">סוג השדה<select class="form-select" data-prop="type"><option value="parent_first">שם פרטי</option><option value="parent_last">שם משפחה</option><option value="phone">טלפון</option><option value="children">רשימת משתתפים נוספים</option><option value="text">טקסט קצר</option><option value="textarea">טקסט ארוך</option><option value="select">בחירה מרשימה</option><option value="checkbox">תיבת סימון</option></select></label></div><div data-for="placeholder"><label class="form-label">טקסט עזר בתוך השדה<input class="form-control" data-prop="placeholder"></label></div><div data-for="options"><label class="form-label">אפשרויות בחירה, אחת בכל שורה<textarea class="form-control" data-prop="options" rows="3"></textarea></label></div><div data-for="people"><label class="form-label">כותרת שם המשתתף<input class="form-control" data-prop="childNameLabel"></label></div><div data-for="people"><label class="form-label">מספר משתתפים מקסימלי להרשמה<input type="number" min="1" class="form-control" data-prop="maxRows" placeholder="ללא מגבלה"></label></div><div class="d-flex gap-3 flex-wrap"><label><input type="checkbox" class="form-check-input" data-prop="required"> חובה</label><label data-for="checkbox"><input type="checkbox" class="form-check-input" data-prop="checkedByDefault"> מסומן מראש</label><label data-for="people"><input type="checkbox" class="form-check-input" data-prop="collectAge"> איסוף גיל</label></div></div><div class="d-flex gap-2 mt-3"><button type="button" class="btn btn-sm btn-light" data-move="-1" aria-label="הזזת שדה למעלה">↑</button><button type="button" class="btn btn-sm btn-light" data-move="1" aria-label="הזזת שדה למטה">↓</button><button type="button" class="btn btn-sm btn-outline-danger ms-auto" data-remove-field>הסרת שדה</button></div></details></template>
