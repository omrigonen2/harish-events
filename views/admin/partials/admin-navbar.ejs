<% const path = locals.currentPath || ''; const navUser = locals.sessionUser || {}; const organizations = locals.navAccounts || []; %>
<aside class="admin-sidebar" aria-label="ניווט ראשי">
  <a href="/admin" class="admin-brand"><span class="brand-symbol" aria-hidden="true">א</span><span>אומני חריש<small>ניהול אירועים וקהילה</small></span></a>
  <div class="nav-caption">סביבת עבודה</div>
  <nav class="admin-main-nav">
    <a href="/admin" class="<%= path === '/admin' || path === '/admin/' ? 'is-active' : '' %>"><span aria-hidden="true">◷</span> סקירה כללית</a>
    <a href="/admin/events" class="<%= path.startsWith('/admin/events') ? 'is-active' : '' %>"><span aria-hidden="true">▦</span> אירועים</a>
    <% if (navUser.role === 'superadmin') { %><a href="/admin/settings" class="<%= path.includes('/settings') || path.includes('/accounts') || path.includes('/integrations') ? 'is-active' : '' %>"><span aria-hidden="true">⚙</span> הגדרות וארגונים</a><% } %>
  </nav>
  <div class="admin-sidebar-bottom"><strong><%= navUser.displayName || 'מנהל' %></strong><small><%= navUser.role === 'superadmin' ? 'מנהל מערכת' : 'צוות האירועים' %></small><form action="/admin/logout" method="post"><button class="btn btn-sm btn-light w-100 mt-3">יציאה מהמערכת</button></form></div>
</aside>
<header class="admin-topbar">
  <details class="mobile-navigation"><summary>תפריט</summary><nav><a href="/admin">סקירה כללית</a><a href="/admin/events">אירועים</a><% if (navUser.role === 'superadmin') { %><a href="/admin/settings">הגדרות</a><% } %><form action="/admin/logout" method="post"><button class="btn btn-light btn-sm">יציאה</button></form></nav></details>
  <% if (navUser.role === 'superadmin' && organizations.length) { %>
    <form method="post" action="/admin/set-active-account" class="organization-switch"><label for="organization-select">ארגון</label><select id="organization-select" name="accountId" onchange="this.form.requestSubmit()"><option value="all">כל הארגונים</option><% organizations.forEach(a => { %><option value="<%= a._id %>" <%= String(a._id) === navUser.activeAccountId ? 'selected' : '' %>><%= a.name %></option><% }); %></select></form>
  <% } else { %><span class="text-muted"><%= navUser.activeAccountName || 'ניהול אירועים' %></span><% } %>
  <% if (memberships && memberships.length > 1) { %><form method="post" action="/admin/set-active-account"><select aria-label="החלפת ארגון" name="accountId" onchange="this.form.requestSubmit()"><% memberships.forEach(m => { %><option value="<%= m.accountId._id %>" <%= String(m.accountId._id) === navUser.activeAccountId ? 'selected' : '' %>><%= m.accountId.name %></option><% }); %></select></form><% } %>
  <a href="/" target="_blank" rel="noopener" class="topbar-public-link">פתיחת האתר ↗</a>
</header>
