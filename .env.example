NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/event_signup
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Wasender API — used for optional WhatsApp ticket delivery
WASENDER_API_KEY=
WASENDER_BASE_URL=https://www.wasenderapi.com

# iDrive e2 (S3-compatible) — private bucket
# Endpoint: from your iDrive e2 bucket settings, e.g. https://abc123.e2.idrivee2-10.com
IDRIVE_E2_ENDPOINT=https://ACCOUNT_ID.e2.idrivee2-XX.com
IDRIVE_E2_REGION=us-east-1
IDRIVE_E2_ACCESS_KEY=your-access-key
IDRIVE_E2_SECRET_KEY=your-secret-key
IDRIVE_E2_BUCKET=your-bucket-name

# First-time setup:
#   1. node scripts/migrate-add-accounts.js   — create default account + backfill events
#   2. node scripts/seed-superadmin.js <email> <password> [displayName]
